{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "webmcp-evals.schema.json",
  "type": "object",
  "required": ["version", "cases"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "assertions"],
        "properties": {
          "id": { "type": "string" },
          "precondition": { "type": "string" },
          "prompt": { "type": "string" },
          "expectedSequence": { "type": "array", "items": { "type": "string" } },
          "mustNotCall": { "type": "array", "items": { "type": "string" } },
          "assertions": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
